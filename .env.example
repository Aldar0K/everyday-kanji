# Скопируйте в .env и подставьте реальные значения.
# Файл .env в репозиторий не коммитится.

# --- PostgreSQL ---
POSTGRES_USER=kanji
POSTGRES_PASSWORD=change-me
POSTGRES_DB=everyday_kanji

# --- Подключения ---
# Внутри Compose хосты db и redis; значения переопределяются в docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://kanji:change-me@db:5432/everyday_kanji
REDIS_URL=redis://redis:6379/0

# --- Публикация ---
# Порт на 127.0.0.1, который слушает nginx — единственная точка входа.
APP_PORT=8082

# --- Окружение ---
# development | production
# От этого зависит флаг Secure у куки device_id: в production он включён,
# в development выключен, иначе браузер отбросит куку по обычному HTTP.
ENVIRONMENT=development

# --- Лимиты запросов (на IP) ---
RATE_LIMIT_READ_PER_MINUTE=60
RATE_LIMIT_WRITE_PER_MINUTE=20

# --- Кэш ---
KANJI_CACHE_TTL_SECONDS=3600
