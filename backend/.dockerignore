# Контекст сборки бэкенда — это каталог backend/, поэтому файл должен лежать
# здесь. Корневой .dockerignore на него не действует: Docker ищет .dockerignore
# в корне контекста, а не репозитория.

# Исходники справочника: десятки мегабайт дампов, нужные только скриптам
# сборки на хосте. В образе им делать нечего.
data/raw

# Промежуточные файлы атомарной записи черновика и файла вычитки.
data/*.json.tmp

# Со звёздочками: шаблон без ** матчит только корень контекста, а каталоги
# кэша лежат в каждом пакете.
**/__pycache__
**/*.py[cod]
**/.venv
**/venv

.env
