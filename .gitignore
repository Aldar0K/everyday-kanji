# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Секреты — только локально
.env
# Ключ для скриптов сборки контента. Отдельно от .env намеренно: .env целиком
# уезжает в контейнер через env_file, а этому ключу там делать нечего.
.env.scripts

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Исходники для сборки справочника: качаются скриптом, весят десятки мегабайт
backend/data/raw/

# Промежуточные файлы атомарной записи черновика и файла вычитки
backend/data/*.json.tmp

# Кэш зависимостей Vite
.vite/
