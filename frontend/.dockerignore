# Контекст сборки фронтенда — каталог frontend/, поэтому файл лежит здесь:
# корневой .dockerignore на этот контекст не действует.

# Исключать node_modules нужно не ради скорости, а ради корректности. В
# Dockerfile сначала идёт npm ci, и только потом COPY . . — без этой строки
# хостовый node_modules копируется ПОВЕРХ установленного в образе. Собранные
# под macOS бинарники затирали бы линуксовые, и сборка падала бы или давала
# неверный бандл.
node_modules

# Локальная сборка не должна попадать в образ: бандл делается внутри.
dist
.vite

*.local
.env
